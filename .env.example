# Copy this to .env locally if you want (do NOT commit real .env)
# Used as reference for Render Environment Variables

DB_URL=jdbc:mysql://YOUR_HOST:3306/YOUR_DB?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
JWT_SECRET=change-this-to-a-long-random-secret-key-at-least-32-chars
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND-NAME.onrender.com
DDL_AUTO=update
SHOW_SQL=false
